{
  "format": "IPv6",
  "instrumentation": "frida",
  "binary_linux": "ipv4ipv6/linux-ipv6-parser",
  "fields": ["group1", "group2", "group3", "group4", "group5", "group6", "group7", "group8"],
  "valid_examples": [
    "2001:0db8:0000:0000:0000:ff00:0042:8329",
    "2001:db8::1",
    "::1",
    "::",
    "fe80::1",
    "ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff",
    "2001:db8::192.0.2.33",
    "::192.0.2.1",
    "1:2:3:4:5::7:8",
    "1::ffff:192.168.0.1",
    "0:0:0:0:0:FFFF:129.144.52.38"
  ],
  "semantic_rules": [
    "group_boundary",
    "replace_with_valid_example",
    "double_colon_position",
    "compressed_valid_form",
    "embedded_ipv4_valid_form",
    "embedded_ipv4_boundary",
    "triple_colon",
    "triple_colon_full_width",
    "compressed_overflow",
    "dangling_compression_tail",
    "mixed_notation",
    "invalid_mixed_suffix",
    "extra_groups",
    "missing_groups",
    "wrong_separator",
    "overflow_group",
    "leading_zeros",
    "zone_id",
    "multiple_double_colons",
    "colon_run",
    "empty_group",
    "whitespace_injection"
  ],
  "havoc_operators": {
    "bit_flip":        0.18,
    "byte_substitute": 0.18,
    "arithmetic":      0.12,
    "splice":          0.12,
    "delete_range":    0.10,
    "insert_random":   0.10,
    "interesting_byte": 0.20
  },
  "binary_linux_timeout_seconds": 360
}
