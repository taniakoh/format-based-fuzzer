{
  "format": "Cidrize",
  "instrumentation": "frida",
  "fields": [
    "address",
    "cidr_prefix",
    "range_start",
    "range_end",
    "wildcard",
    "separator"
  ],
  "valid_examples": [
    "1.2.3.4",
    "192.0.2.64/26",
    "192.0.2.80-192.0.2.85",
    "192.0.2.170-175",
    "192.0.2.8[0-5]",
    "192.0.2.[5678]",
    "edge.ai",
    "alpha.museum",
    "svc.example.dev",
    "2001:db8::1",
    "2001:db8::/64",
    "2001:db8::1-2001:db8::5",
    "::ffff:192.0.2.33/128"
  ],
  "semantic_rules": [
    "address_boundary",
    "scope_alias",
    "cidr_prefix",
    "cidr_missing_prefix",
    "range_flip",
    "partial_range_end",
    "separator_repeat",
    "stacked_prefix",
    "wildcard_repeat",
    "range_boundary_drop",
    "adjacent_mask",
    "wildcard_damage",
    "separator_confusion",
    "hostname_tld_edge",
    "token_duplication",
    "list_separator_variation",
    "whitespace_injection"
  ],
  "havoc_operators": {
    "bit_flip": 0.18,
    "byte_substitute": 0.18,
    "arithmetic": 0.14,
    "splice": 0.12,
    "delete_range": 0.12,
    "insert_random": 0.10,
    "interesting_byte": 0.16
  },
  "binary_windows": "cidrize-runner-main/bin/win-cidrize-runner.exe",
  "binary_linux": "cidrize-runner-main/bin/linux-cidrize-runner",
  "binary_windows_args": ["--func", "cidrize"],
  "binary_linux_args": ["--func", "cidrize"],
  "binary_linux_timeout_seconds": 360
}
